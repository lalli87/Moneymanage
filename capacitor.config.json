{
  "appId": "ca.kamal.moneybook.app",
  "appName": "MoneyBook",
  "webDir": "www",
  "android": {
    "path": "native-android",
    "allowMixedContent": false
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    },
    "LocalNotifications": {
      "iconColor": "#E8685A"
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DEFAULT"
    }
  }
}